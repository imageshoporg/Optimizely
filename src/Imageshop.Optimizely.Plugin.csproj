<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
	  <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
	  <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Configurations>Release;Debug</Configurations>
    <IsPackable>true</IsPackable>
    <NuspecFile>Imageshop.Optimizely.Plugin.nuspec</NuspecFile>
    <RootNamespace>Imageshop.Optimizely.Plugin</RootNamespace>
    <RestorePackages>true</RestorePackages>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Import\imageshop.xml" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Import\imageshop.xml" />
  </ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="EPiServer.CMS.TinyMce" Version="4.2.0" />
		<PackageReference Include="EPiServer.CMS.UI" Version="12.18.0" />
		<PackageReference Include="EPiServer.CMS.UI.Core" Version="12.18.0" />
		<PackageReference Include="EPiServer.Framework" Version="12.14.0" />
		<PackageReference Include="EPiServer.CMS.Core" Version="12.14.0" />
		<PackageReference Include="System.Json" Version="4.7.1" />
		<PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.0" />
	</ItemGroup>


	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="EPiServer.CMS.UI.Core" Version="[13.0.0,14.0.0)" />
		<PackageReference Include="EPiServer.CMS.TinyMce" Version="[13.0.0,14.0.0)" />
		<PackageReference Include="EPiServer.CMS.Core" Version="[13.0.0,14.0.0)" />
		<PackageReference Include="EPiServer.Logging" Version="[13.0.0,14.0.0)" />
	</ItemGroup>

</Project>